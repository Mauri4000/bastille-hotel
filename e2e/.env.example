# ============================================================
# Variables de entorno para el framework E2E de Bastille Hotel
# Copia este archivo a .env y completa los valores reales
# NUNCA subas .env a git
# ============================================================

# URL base de la aplicacion (produccion o staging)
BASE_URL=https://bastille-hotel-chi.vercel.app

# Credenciales de usuario admin de prueba
TEST_EMAIL=test@bastillehotel.com
TEST_PASSWORD=tu_password_aqui

# Credenciales invalidas para tests negativos (no cambiar)
INVALID_EMAIL=no-existe@fake.com
INVALID_PASSWORD=WrongPass123!

# Timeout general en milisegundos
DEFAULT_TIMEOUT=30000

# Modo headless: true = sin ventana del browser (para CI), false = con ventana (debug local)
HEADLESS=false

# Supabase — opcional, para login via API (mas rapido que UI)
# Si no se configuran, el framework usa login por UI automaticamente
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key-publica
