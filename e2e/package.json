{
  "name": "bastille-hotel-e2e",
  "version": "1.0.0",
  "description": "Playwright BDD automation framework for Bastille Hotel",
  "private": true,
  "scripts": {
    "test": "cucumber-js --config cucumber.json --profile default",
    "test:smoke": "cucumber-js --config cucumber.json --profile smoke",
    "test:e2e": "cucumber-js --config cucumber.json --profile e2e",
    "test:regression": "cucumber-js --config cucumber.json --profile regression",
    "ts:check": "tsc --noEmit",
    "install:browsers": "npx playwright install chromium"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.48.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
